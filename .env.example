# ─────────────────────────────────────────────────────────────
# Enterprise IT Service Desk — environment variables
# Copy to .env (local) or .env.docker (compose). NEVER commit real secrets;
# in Azure use App Settings backed by Key Vault references.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL="postgresql://servicedesk:servicedesk@localhost:5432/servicedesk?schema=public"

# Public base URL of the app (used for Origin checks, HSTS and redirect URIs)
APP_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# Session encryption secret — generate with:  openssl rand -base64 33
AUTH_SECRET=""

# Microsoft Entra ID (multi-tenant app registration)
#   Redirect URI (Web): {APP_URL}/api/auth/callback/microsoft-entra-id
#   Supported account types: "Accounts in any organizational directory (Multitenant)"
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# Optional: defaults to the multi-tenant "organizations" endpoint
# AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/organizations/v2.0"

# Developer login (pick a seeded user without Microsoft). Ignored when NODE_ENV=production.
AUTH_DEV_LOGIN=false

# Attachment storage: "local" (disk) or "azure" (Blob Storage / Azurite)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net"
# AZURE_STORAGE_CONTAINER=attachments

# Tests (optional): server where a throwaway DB may be created per test run
# TEST_DATABASE_ADMIN_URL="postgresql://servicedesk:servicedesk@localhost:5432/postgres"

# Realtime (Socket.IO). Optional Redis for multiple app instances (Azure Cache for Redis):
# REDIS_URL="rediss://:<key>@<name>.redis.cache.windows.net:6380"

# Background jobs (SLA warning/breach/escalation, task overdue, auto-close)
# Runs inside the app server every N seconds; multi-instance safe (database lease).
JOBS_ENABLED=true
JOBS_INTERVAL_SECONDS=60
