{
  "name": "servicedesk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch --clear-screen=false --ignore ./.next --ignore ./node_modules --ignore ./storage server.ts",
    "build": "next build && pnpm build:server",
    "start": "NODE_ENV=production node dist/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:demo": "tsx prisma/seed-demo.ts",
    "db:reset": "prisma migrate reset --force",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test --trace off",
    "format": "prettier --write .",
    "dev:next": "next dev",
    "build:server": "esbuild server.ts --bundle --platform=node --target=node22 --format=cjs --packages=external --outfile=dist/server.js",
    "jobs:run": "tsx scripts/run-jobs.ts",
    "audit:export": "tsx scripts/audit-export.ts",
    "lint:i18n": "tsx scripts/check-i18n.ts"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.34.0",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@socket.io/redis-adapter": "8.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "geist": "^1.9.2",
    "lucide-react": "^1.76.0",
    "next": "15.5.29",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "4.3.12",
    "next-themes": "^0.4.6",
    "prisma": "6.19.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "2.15.4",
    "redis": "^6.3.1",
    "server-only": "^0.0.1",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "tailwind-merge": "^3.7.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "prettier": "^3.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
